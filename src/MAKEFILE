ECONOMY.OBJ: ECONOMY.C CIV.H ADVISORS.H AUDIENCE.H CITYMGT.H DIALOG.H GAME.H GLOBALS.H MAP.H \
	MESSAGE.H PEDIA.H RESIDENT.H SPACESHP.H UNITAI.H UNITS.H CAPTURE.H CORE.H ECONOMY.H FILEIO.H \
	NEWGAME.H NEWS.H NOTES.H TURN.H GRAPHICS.H
	cl /AM /Gs /Oas $(CFLAGS) /NTF0ADE ECONOMY.C >>MSC.LOG

#	Reconstructed low-memory MSC condition for CITYMGT; CONTROL is
#	compiled without it, so its ai_turn is post-optimized.

CONTROL.OBJ: CONTROL.C CIV.H RESIDENT.H GAME.H ADVISORS.H BATTLE.H CAPTURE.H CITY.H CITYMGT.H \
	CONTROL.H CORE.H DIALOG.H DIPLOMAC.H DIPLOMAT.H ECONOMY.H FAME.H FILEIO.H MAP.H MAPVIEW.H \
	MENUS.H MESSAGE.H NAMES.H NEWGAME.H NEWS.H NOTES.H PEDIA.H REPLAY.H REPORTS.H SAVE.H STATUS.H \
	TURN.H UNITAI.H UNITS.H DRAW.H PATH.H GLOBALS.H GRAPHICS.H
	cl /AM /Gs /Oas $(CFLAGS) /NTF0403 CONTROL.C >>MSC.LOG

CITYMGT.OBJ: CITYMGT.C CIV.H RESIDENT.H GAME.H BATTLE.H CAPTURE.H CITYMGT.H CITYVIEW.H \
	CONTROL.H CORE.H DIALOG.H DIPLOMAT.H DRAW.H ECONOMY.H MAP.H NAMES.H NEWGAME.H NEWS.H NOTES.H \
	SPACESHP.H TURN.H UNITS.H DIPLOMAC.H MESSAGE.H UNITAI.H GRAPHICS.H
	loadfix -192 cl /AM /Gs /Oas $(CFLAGS) /NTF0D12 CITYMGT.C >>MSC.LOG

RESIDENT.OBJ: RESIDENT.ASM TIMER.INC PALETTE.INC FADE.INC FCHECK.INC  F0STATE.INC DRIVER.INC \
	LOADER.INC
	masm /ML /T RESIDENT.ASM,RESIDENT.OBJ; >>MASM.LOG

STRBIOS.OBJ: STRBIOS.ASM
	masm /ML /T STRBIOS.ASM,STRBIOS.OBJ; >>MASM.LOG

UNITS.OBJ: UNITS.C CIV.H AUDIENCE.H DIALOG.H DIPLOMAC.H DRIVER.H GAME.H GLOBALS.H RESIDENT.H \
	UNITAI.H CITY.H CONTROL.H CORE.H ECONOMY.H MAP.H MESSAGE.H NOTES.H UNITS.H CAPTURE.H DRAW.H \
	TURN.H GRAPHICS.H
	cl /AM /Gs /Oas $(CFLAGS) /NTF0866 UNITS.C >>MSC.LOG

GRAPHICS.OBJ: GRAPHICS.ASM F0STATE.INC LOADTAIL.INC RASTER.INC PICTURE.INC  MOUSE.INC
	masm /ML /T GRAPHICS.ASM,GRAPHICS.OBJ; >>MASM.LOG

