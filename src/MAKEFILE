#############################################################
#
#	Civilization (1991) reconstruction: description file for
#	Microsoft Program Maintenance Utility 4.07 (MSC 5.1).
#
#	Usage, with C:\BIN (MSC 5.1, MASM 5.10, LINK 5.01) on PATH
#	and INCLUDE=C:\INCLUDE:
#
#		make MAKEFILE
#
#	Each object rule keeps its own optimizer and /NT segment
#	options. The response file fixes the object and library
#	order used by LINK.
#
#############################################################

CFLAGS=/Zl /c /W3 /Fc
LIBS=C:\LIB\MLIBCR.LIB+C:\LIB\LIBH.LIB

GLOBALS.OBJ: GLOBALS.C CIV.H GLOBALS.H
	cl /AM /Gs /Oas $(CFLAGS) GLOBALS.C >>MSC.LOG

GAME.OBJ: GAME.C AUDIENCE.H DIALOG.H F0DATA.H GLOBALS.H RESIDENT.H CORE.H FAME.H FILEIO.H \
	GAME.H INTRO.H MESSAGE.H NEWGAME.H SAVE.H SETUP.H TURN.H WORLDGEN.H GRAPHICS.H
	cl /AM /Gs /Oas $(CFLAGS) /NTF01A8 GAME.C >>MSC.LOG

TURN.OBJ: TURN.C CORE.H GAME.H GLOBALS.H RESIDENT.H SPACESHP.H UNITS.H CAPTURE.H CITY.H \
	CONTROL.H DIALOG.H DIPLOMAC.H DRAW.H ECONOMY.H FAME.H FILEIO.H INTRO.H MAP.H MESSAGE.H NEWS.H \
	PALACE.H PEDIA.H QUIZ.H REPLAY.H REPORTS.H SAVE.H TURN.H UNITAI.H WORLDGEN.H GRAPHICS.H
	cl /AM /Gs /Oas $(CFLAGS) /NTF0238 TURN.C >>MSC.LOG

BATTLE.OBJ: BATTLE.C CIV.H GAME.H GLOBALS.H MAP.H RESIDENT.H UNITS.H BATTLE.H CITYMGT.H \
	DIPLOMAC.H DIPLOMAT.H MESSAGE.H UNITAI.H CAPTURE.H TURN.H GRAPHICS.H
	cl /AM /Gs /Oas $(CFLAGS) /NTF19F3 BATTLE.C >>MSC.LOG

