F0DATA.OBJ: F0DATA.ASM
	masm /ML /T F0DATA.ASM,F0DATA.OBJ; >>MASM.LOG

#	The game. LINK names its output CIV.EXE; the unmodified
#	linker output is retained as CIVRAW.EXE.

CIVRAW.EXE: RESIDENT.OBJ GLOBALS.OBJ STRBIOS.OBJ DRAW.OBJ GAME.OBJ TURN.OBJ CONTROL.OBJ \
	UNITS.OBJ ECONOMY.OBJ CITYMGT.OBJ GRAPHICS.OBJ CAPTURE.OBJ \
	DIPLOMAC.OBJ UNITAI.OBJ BATTLE.OBJ MAP.OBJ MENUS.OBJ DIALOG.OBJ CORE.OBJ \
	PATH.OBJ MESSAGE.OBJ FILEIO.OBJ IMAGE.OBJ SETUP.OBJ INTRO.OBJ FAME.OBJ \
	NOTES.OBJ NEWGAME.OBJ AUDIENCE.OBJ WORLDGEN.OBJ PEDIA.OBJ REPLAY.OBJ \
	MAPVIEW.OBJ SAVE.OBJ REPORTS.OBJ STATUS.OBJ ADVISORS.OBJ CIVWAR.OBJ \
	QUIZ.OBJ PALACE.OBJ SPACESHP.OBJ CITYVIEW.OBJ CITY.OBJ NEWS.OBJ \
	DIPLOMAT.OBJ NAMES.OBJ F0DATA.OBJ LINK.RSP
	if exist CIVRAW.EXE del CIVRAW.EXE
	link /MAP /INF /EXEPACK @LINK.RSP >LINK.LOG
	ren CIV.EXE CIVRAW.EXE

#	User-approved, pinned four-byte startup exception;
#	no object or library edits.

CRTEDIT.OBJ: CRTEDIT.C
	cl /AM /Gs /O /Zl /c /W3 CRTEDIT.C >>MSC.LOG

CRTEDIT.EXE: CRTEDIT.OBJ
	link CRTEDIT.OBJ,CRTEDIT.EXE,NUL,$(LIBS); >CRTEDIT.LOG

CIV.EXE: CIVRAW.EXE CRTEDIT.EXE
	CRTEDIT >EDIT.LOG

#	Drivers CIV loads at run time (separate programs, built the
#	same way the originals were: MASM, then LINK with no libraries).

MGRAPHIC.OBJ: MGRAPHIC.ASM
	masm /ML /T MGRAPHIC.ASM,MGRAPHIC.OBJ; >>MASM.LOG

MGRAPHIC.EXE: MGRAPHIC.OBJ
	link MGRAPHIC.OBJ,MGRAPHIC.EXE,NUL; >>LINK.LOG

ASOUND.OBJ: ASOUND.ASM
	masm /ML /T ASOUND.ASM,ASOUND.OBJ; >>MASM.LOG

ASOUND.CVL: ASOUND.OBJ
	link ASOUND.OBJ,ASOUND.CVL,NUL; >>LINK.LOG

MISC.OBJ: MISC.ASM
	masm /ML /T MISC.ASM,MISC.OBJ; >>MASM.LOG

MISC.EXE: MISC.OBJ
	link /CPARMAXALLOC:2 MISC.OBJ,MISC.EXE,NUL; >>LINK.LOG
