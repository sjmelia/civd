	CITYMGT.H CONTROL.H CORE.H DIPLOMAC.H ECONOMY.H MAP.H PATH.H TURN.H UNITS.H GRAPHICS.H
	cl /AM /Gs /Oas $(CFLAGS) /NTF15FB UNITAI.C >>MSC.LOG

